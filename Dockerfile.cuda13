# Use the official PyTorch image with CUDA support
FROM pytorch/pytorch:2.9.0-cuda13.0-cudnn9-devel

# Working directory
WORKDIR /app

# Set Hugging Face cache directory so model downloads are stored predictably
ENV HF_HOME=/app/models_cache

# 1. Install System Dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libsndfile1 \
    git && \
    rm -rf /var/lib/apt/lists/*

# 2. Install Application Requirements & Re-align Torchvision
COPY requirements-cuda13.txt /app/
# We add the extra-index-url so pip grabs CUDA-compatible wheels instead of PyPI CPU defaults.
# --use-deprecated=legacy-resolver: the requirements are ~fully pinned (==), but vLLM pulls a
# handful of unbounded transitive deps (openai>=, mistral-common>=, opencv>=, ...). The 2025 pip
# backtracking resolver re-explores those against the pinned set and dies with `resolution-too-deep`.
# The legacy resolver is first-found-wins (no backtracking), so it installs the pinned set directly.
# The second step pins the exact cu130 torch family (index-url, not extra) so the builds are
# guaranteed CUDA 13 wheels; versions are fixed so it can't drift off torch 2.9.0 (vLLM's pin).
RUN pip install --no-cache-dir --use-deprecated=legacy-resolver -r requirements-cuda13.txt --extra-index-url https://download.pytorch.org/whl/cu130 && \
    pip install --no-cache-dir torch==2.9.0 torchvision==0.24.0 torchaudio==2.9.0 --index-url https://download.pytorch.org/whl/cu130

# 3. Copy Application Code & Modules
COPY speaker_rag/age_model/ /app/age_model/
COPY speaker_rag/ /app/speaker_rag/
COPY api/ /app/api/
COPY download_models.py /app/
COPY gunicorn_conf.py /app/

# 4. Pre-Download Models into the Image
RUN python download_models.py

# 5. Database Persistence (CRITICAL)
RUN mkdir -p /app/enrolled_data/chroma
VOLUME ["/app/enrolled_data"]

# Expose port
EXPOSE 8007

# Start Server
CMD ["gunicorn", "--config", "gunicorn_conf.py", "api.endpoints:app"]